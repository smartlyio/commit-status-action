{
  "extends": [
    "config:best-practices"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true,
    "labels": [
      "no release",
      "renovate-deps"
    ],
    "automerge": true
  },
  "minimumReleaseAge": "30 days",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "minimumReleaseAge": null,
      "automerge": true
    }
  ]
}
